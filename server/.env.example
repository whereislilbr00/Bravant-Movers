# ===========================================
# BRAVANT MOVERS - ENVIRONMENT VARIABLES
# ===========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas (Already configured)
MONGODB_URI=mongodb+srv://bravant_admin:Bravant-Movers26@cluster0.6pz4iu6.mongodb.net/bravant-movers

# JWT Secret (Change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=30d

# ===========================================
# STRIPE PAYMENT (International)
# ===========================================
# Get keys from: https://dashboard.stripe.com
# 1. Go to Developers → API keys
# 2. Copy Secret Key (sk_test_...) and Publishable Key (pk_test_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===========================================
# PESAPAL PAYMENT (Kenya)
# ===========================================
# Get credentials from: https://developer.pesapal.com/
# Register for merchant account, then get Consumer Key & Secret
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_MODE=sandbox  # Use "live" for production

# ===========================================
# EMAIL CONFIGURATION (Gmail)
# ===========================================
# For Gmail:
# 1. Go to myaccount.google.com → Security
# 2. Enable 2-Step Verification
# 3. Go to myaccount.google.com/apppasswords
# 4. Generate App Password for "Mail"
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password

# Alternative: Use SendGrid
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=your_sendgrid_api_key

# ===========================================
# FRONTEND URL (for CORS & emails)
# ===========================================
CLIENT_URL=http://localhost:3000
